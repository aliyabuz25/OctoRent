{
  "name": "octostock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "dev:mobile": "vite --config vite.config.ionic.js --host --port 5174",
    "dev:all": "concurrently -n api,web,mobile -c blue,green,yellow \"npm:dev:server\" \"npm:dev:client\" \"npm:dev:mobile\"",
    "server": "node server/index.js",
    "build": "vite build",
    "build:mobile": "vite build --config vite.config.ionic.js",
    "preview": "vite preview",
    "android:apk": "./scripts/generate-apk.sh",
    "admin:native:build": "cmake -S tools/admin-native -B build-admin && cmake --build build-admin --config Release"
  },
  "dependencies": {
    "@ionic/react": "^9.0.7",
    "@ionic/react-router": "^9.0.7",
    "7.css": "^0.21.1",
    "bootstrap-icons": "^1.13.2",
    "chart.js": "^4.6.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "feather-icons": "^4.29.2",
    "html5-qrcode": "^2.3.8",
    "ionicons": "^8.1.0",
    "ioredis": "^5.4.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.61.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "react-feather": "^2.0.10",
    "react-router-dom": "^6.30.6",
    "sweetalert2": "^11.26.25",
    "tabulator-tables": "^6.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "androidjs-builder": "^2.3.2",
    "concurrently": "^9.1.0",
    "vite": "^6.0.7"
  }
}
